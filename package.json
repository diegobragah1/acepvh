{
  "name": "ace-semusa-portovelho-2026",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && mkdir -p assets public/assets && cp -f dist/assets/* assets/ && cp -f dist/assets/* public/assets/",
    "preview": "vite preview --host 0.0.0.0 --port 3000",
    "test": "node --import tsx --test src/utils/*.test.ts",
    "audit:content": "node --import tsx scripts/audit_content.ts",
    "audit:report": "node --import tsx scripts/audit_content.ts --write",
    "audit:curriculum": "node --import tsx scripts/audit_curriculum.ts --write",
    "audit:rlm": "node --import tsx scripts/review_rlm_answers.ts",
    "content:export": "node --import tsx scripts/export_deepening.ts",
    "check": "npm test && npm run audit:content && tsc --noEmit"
  },
  "dependencies": {
    "katex": "^0.19.1",
    "lucide-react": "^0.344.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/katex": "^0.16.8",
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "tsx": "^4.23.15",
    "typescript": "^5.4.5",
    "vite": "^5.3.1"
  }
}
